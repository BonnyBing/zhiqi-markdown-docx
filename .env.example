# 转换接口密钥，智启插件的 x-api-key 必须与此相同。请使用足够长的随机字符串。
DOCX_API_KEY=

# Vercel Blob 读写令牌。不要提交真实值。
BLOB_READ_WRITE_TOKEN=

# Markdown 最大字节数，默认 120KB。
MAX_MARKDOWN_BYTES=122880

# 已停用。任意公网 HTTPS 图片都会嵌入，不再按域名限制（仍拒绝内网与非 HTTPS）。
ALLOWED_IMAGE_HOSTS=

# Blob 文件保留小时数，默认 72。
FILE_RETENTION_HOURS=72

# 部署后的站点根 URL，例如 https://your-project.vercel.app
PUBLIC_BASE_URL=

# 清理接口密钥。Vercel Cron 会自动发送 Authorization: Bearer <CRON_SECRET>。
CRON_SECRET=

# 仅在确认 Vercel Cron 确实会执行时设为 true。Hobby 套餐请保持 false 或留空。
CLEANUP_ENABLED=false

# 浏览器 CORS 白名单，逗号分隔。留空表示允许任意来源（智启插件试运行需要跨域）。
ALLOWED_ORIGINS=
