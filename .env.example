# 转换接口密钥，智启插件的 x-api-key 必须与此相同。请使用足够长的随机字符串。
DOCX_API_KEY=

# —— 存储二选一 ——
# 公司 Docker / 自建：本机目录（优先）。例：/data
LOCAL_STORAGE_DIR=
# Vercel 部署：Blob 读写令牌。不要提交真实值。
BLOB_READ_WRITE_TOKEN=

# Markdown 最大字节数，默认 120KB。
MAX_MARKDOWN_BYTES=122880

# 已停用。任意公网 HTTPS 图片都会嵌入，不再按域名限制（仍拒绝内网与非 HTTPS）。
ALLOWED_IMAGE_HOSTS=

# 公司内网可信任图片主机（不含端口）。Docker 部署填知识图谱所在 IP，以便嵌入图谱 PNG。
# 例：TRUSTED_IMAGE_HOSTS=10.20.0.34
TRUSTED_IMAGE_HOSTS=

# Blob / 本机文件保留小时数，默认 72。
FILE_RETENTION_HOURS=72

# 部署后的站点根 URL。Docker 端口直出例：http://10.20.0.34:8100
PUBLIC_BASE_URL=

# 清理接口密钥。Vercel Cron 会自动发送 Authorization: Bearer <CRON_SECRET>。
CRON_SECRET=

# 仅在确认定时清理确实会执行时设为 true。
CLEANUP_ENABLED=false

# 浏览器 CORS 白名单，逗号分隔。留空表示允许任意来源（智启插件试运行需要跨域）。
ALLOWED_ORIGINS=
