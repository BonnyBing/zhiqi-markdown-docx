{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/generate-docx.ts": {
      "maxDuration": 60
    },
    "api/cleanup-docx.ts": {
      "maxDuration": 60
    },
    "api/health.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cleanup-docx",
      "schedule": "0 4 * * *"
    }
  ]
}
