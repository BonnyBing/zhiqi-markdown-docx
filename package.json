{
  "name": "zhiqi-markdown-docx",
  "version": "1.0.0",
  "private": true,
  "description": "智启插件用 Markdown 转 Word(DOCX) 服务，部署于 Vercel，文件保存在 Vercel Blob。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/bundle-api.mjs",
    "dev": "vercel dev",
    "sample": "tsx scripts/generate-sample.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "docx": "^9.5.1",
    "image-size": "^2.0.2",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@vercel/node": "^5.1.7",
    "jszip": "^3.10.1",
    "tsx": "^4.19.2",
    "esbuild": "^0.25.9",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "yaml": "^2.7.0"
  }
}
